<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12151C">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="18dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="연결" android:textColor="#E8EDF5" android:textSize="17sp"
        android:textStyle="bold" android:paddingBottom="6dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Notion 통합 토큰" android:textColor="#9AA7B8" android:paddingTop="8dp"/>
    <EditText android:id="@+id/token" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="textPassword"
        android:textColor="#E8EDF5" android:hint="ntn_... / secret_..." android:textColorHint="#69758A"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="페이지 URL 또는 ID" android:textColor="#9AA7B8" android:paddingTop="8dp"/>
    <EditText android:id="@+id/pageId" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="textUri"
        android:textColor="#E8EDF5" android:hint="https://www.notion.so/..." android:textColorHint="#69758A"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="표시할 섹션 제목 (비우면 전체 · 쉼표로 여러 개)" android:textColor="#9AA7B8" android:paddingTop="8dp"/>
    <EditText android:id="@+id/section" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="text"
        android:textColor="#E8EDF5" android:hint="예: 오늘 할 일, 주간 목표" android:textColorHint="#69758A"/>

    <CheckBox android:id="@+id/includeHeading" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="섹션 제목도 표시" android:textColor="#E8EDF5"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="최대 표시 개수 (0=전체)" android:textColor="#9AA7B8" android:paddingTop="8dp"/>
    <EditText android:id="@+id/limit" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="number" android:textColor="#E8EDF5"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="자동 갱신 간격(분, 최소 15)" android:textColor="#9AA7B8" android:paddingTop="8dp"/>
    <EditText android:id="@+id/refreshMin" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="number" android:textColor="#E8EDF5"/>

    <Button android:id="@+id/testBtn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="연결 테스트" android:layout_marginTop="10dp"/>
    <TextView android:id="@+id/testResult" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:visibility="gone"
        android:textColor="#E8EDF5" android:background="#0D1017" android:padding="8dp"
        android:layout_marginTop="8dp" android:textSize="12sp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="모양" android:textColor="#E8EDF5" android:textSize="17sp"
        android:textStyle="bold" android:paddingTop="18dp" android:paddingBottom="6dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="테마" android:textColor="#9AA7B8"/>
    <Spinner android:id="@+id/theme" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:entries="@array/theme_options"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="강조색" android:textColor="#9AA7B8" android:paddingTop="8dp"/>
    <EditText android:id="@+id/accent" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:inputType="text"
        android:textColor="#E8EDF5" android:hint="#4F8CFF" android:textColorHint="#69758A"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="10dp">
      <TextView android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:text="글자 크기" android:textColor="#9AA7B8"/>
      <TextView android:id="@+id/fontSizeVal" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:textColor="#E8EDF5"/>
    </LinearLayout>
    <SeekBar android:id="@+id/fontSize" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_weight="1"
          android:layout_height="wrap_content" android:text="배경 불투명도" android:textColor="#9AA7B8"/>
      <TextView android:id="@+id/bgAlphaVal" android:layout_width="wrap_content"
          android:layout_height="wrap_content" android:textColor="#E8EDF5"/>
    </LinearLayout>
    <SeekBar android:id="@+id/bgAlpha" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <CheckBox android:id="@+id/showTitle" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="페이지 제목 표시" android:textColor="#E8EDF5"/>
    <CheckBox android:id="@+id/showCheckbox" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="체크박스 표시" android:textColor="#E8EDF5"/>

    <Button android:id="@+id/saveBtn" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="저장" android:layout_marginTop="16dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="※ Notion에서 통합을 만든 뒤, 보려는 페이지 ⋯ → 연결 에 그 통합을 추가해야 읽을 수 있습니다.\n※ 홈 화면 길게 누르기 → 위젯 → 'Notion 메모 위젯' 추가. 위젯의 ⟳ 를 누르면 즉시 새로고침됩니다."
        android:textColor="#69758A" android:textSize="12sp" android:paddingTop="14dp"/>
  </LinearLayout>
</ScrollView>
